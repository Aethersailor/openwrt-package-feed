+
+function response_headers(raw)
+{
+	let headers;
+	for (let line in split(raw, "\n")) {
+		let status = match(line, /^HTTP\/\S+\s+([0-9]{3})/);
+		if (status) {
+			headers = { status: int(status[1]) };
+			continue;
+		}
+		let field = match(line, /^([^:]+):\s*(.*)$/);
+		if (headers && field)
+			headers[lc(field[1])] = trim(field[2]);
+	}
+	return headers;
+}
