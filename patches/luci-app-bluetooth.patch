-LUCI_DEPENDS:=+luci-base +bluez-daemon +bluez-alsa +bluez-alsa-utils +expect
+LUCI_DEPENDS:=+luci-base +bluez-daemon +bluez-alsa +bluez-alsa-utils +expect +coreutils-timeout +dbus-utils
 LUCI_PKGARCH:=all
 
 PKG_LICENSE:=GPL-3.0
 PKG_MAINTAINER:=sbwml <admin@cooluc.com>
 
+define Package/luci-app-bluetooth/postinst
+[ -z "$${IPKG_INSTROOT}" ] || exit 0
+# D-Bus may have started before the new BlueZ and BlueALSA policies were installed.
+if dbus-send --system --print-reply --reply-timeout=3000 \
+    --dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.ReloadConfig >/dev/null 2>&1; then
+    for service in bluetoothd bluealsa; do
+        if /etc/init.d/$$service enabled && ! /etc/init.d/$$service running; then
+            /etc/init.d/$$service start
+        fi
+    done
+else
+    logger -t luci-app-bluetooth 'Could not reload D-Bus Bluetooth policies'
+fi
+rm -f /tmp/luci-indexcache.*
+rm -rf /tmp/luci-modulecache/
+/etc/init.d/rpcd reload 2>/dev/null
+exit 0
+endef
+
