#!/bin/sh

# This Office snapshot ships two libubox event loops in the same ucode process.
if [ -z "$LD_PRELOAD" ] &&
   [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = nlnet,xiguapi-v3 ] &&
   grep -Fxq "DISTRIB_REVISION='r43295-2fe3065ade'" /etc/openwrt_release &&
   [ -r /lib/libubox.so.20261103 ] &&
   grep -aqF 'libubox.so.20261103' /usr/lib/ucode/uloop.so &&
   { grep -aqF 'libubox.so.20260721' /usr/lib/libuclient.so ||
     grep -aqF 'libubox.so.20260721' /lib/libustream-ssl.so; }
then
    export LD_PRELOAD=/lib/libubox.so.20261103
    export OWUT_OFFICE_LIBUBOX_PRELOAD=1
fi

exec /usr/libexec/owut "$@"
